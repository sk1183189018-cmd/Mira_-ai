# ==========================================
# MIRA AI ASSISTANT - ENVIRONMENT SETTINGS
# ==========================================

# ------------------------------------------
# OPENAI
# ------------------------------------------

# Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# AI model used by MIRA
MIRA_MODEL=gpt-5.6


# ------------------------------------------
# MIRA APPLICATION
# ------------------------------------------

MIRA_NAME=MIRA
MIRA_LANGUAGE=hinglish

# Development / Production
MIRA_ENV=development

# Enable debug logs
MIRA_DEBUG=true


# ------------------------------------------
# MEMORY
# ------------------------------------------

# SQLite database location
MIRA_DATABASE_URL=sqlite:///data/mira.db


# ------------------------------------------
# VOICE
# ------------------------------------------

# Enable voice features
MIRA_VOICE_ENABLED=true

# Voice language
MIRA_VOICE_LANGUAGE=en-IN

# Wake word
MIRA_WAKE_WORD=hey mira


# ------------------------------------------
# SECURITY
# ------------------------------------------

# Ask confirmation before dangerous actions
MIRA_REQUIRE_CONFIRMATION=true

# Enable audit logging
MIRA_AUDIT_LOGGING=true


# ------------------------------------------
# WEB
# ------------------------------------------

# Maximum web search results
MIRA_WEB_MAX_RESULTS=5


# ------------------------------------------
# AUTOMATION
# ------------------------------------------

MIRA_AUTOMATION_ENABLED=true
